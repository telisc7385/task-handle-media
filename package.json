{
  "name": "headless-media-sdk",
  "version": "0.1.0",
  "private": true,
  "description": "Headless Media SDK + Component Library monorepo (Pexels)",
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" build",
    "build:all": "pnpm -r build",
    "typecheck": "pnpm -r --filter \"./packages/*\" typecheck",
    "test": "pnpm -r --filter \"./packages/*\" test",
    "dev": "pnpm --filter @headless-media/web dev"
  },
  "devDependencies": {
    "typescript": "^5.5.4",
    "vitest": "^2.0.5",
    "@types/node": "^20.14.15"
  }
}
